	fmt.Println("DEBUG: Searching for:", bookingID)
	if err != nil {
		return err
	}

	for i := range allBookings {

		if allBookings[i].ID == bookingID {

			// 🚫 prevent cancel if already paid
			if allBookings[i].PaymentStatus == model.PaymentConfirmed {
				return fmt.Errorf("use refund flow for paid bookings")
			}

			allBookings[i].PaymentStatus = model.PaymentCancelled

			return SaveAllBookings(allBookings)
		}
	}

	return fmt.Errorf("booking not found")
}

func MarkBookingRefunded(bookingID string) error {

	allBookings, err := ReadAllBookings()
	if err != nil {
		return err
	}

	for i := range allBookings {

		if allBookings[i].ID == bookingID {
			// Treat as cancelled — no refund status exposed to users
			allBookings[i].PaymentStatus = model.PaymentCancelled
			return SaveAllBookings(allBookings)
		}
	}

	return fmt.Errorf("booking not found")
}
