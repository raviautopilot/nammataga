/*
// generateJWT creates a JWT token with user claims
func generateJWT(member *model.Member) (string, error) {
	// Get secret from environment
	secret := config.Config.JwtSecret
	if secret == "" {
		return "", jwt.ErrSignatureInvalid
	}

	// Define roles - for now default to USER, can be extended based on user model
	roles := []string{"USER"}

	// Create token
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{
		"sub":   member.EmailId, // user identifier
		"roles": roles,
		"exp":   time.Now().Add(time.Hour * 24).Unix(), // 24 hours expiration
		"iat":   time.Now().Unix(),
	})

	// Sign token
	return token.SignedString([]byte(secret))
}

// JWTMiddleware validates JWT tokens and attaches claims to context
func JWTMiddleware() gin.HandlerFunc {
	return func(c *gin.Context) {
		// Get token from Authorization header
		authHeader := c.GetHeader("Authorization")
		if authHeader == "" {
			c.JSON(http.StatusUnauthorized, gin.H{"error": "Authorization header required"})
			c.Abort()
			return
		}

		// Extract token from Bearer format
		var tokenString string
		fmt.Sscanf(authHeader, "Bearer %s", &tokenString)
		if tokenString == "" {
			c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid authorization format"})
			c.Abort()
			return
		}

		// Parse and validate token
		token, err := jwt.Parse(tokenString, func(token *jwt.Token) (interface{}, error) {
			// Validate signing method
			if _, ok := token.Method.(*jwt.SigningMethodHMAC); !ok {
				return nil, fmt.Errorf("unexpected signing method: %v", token.Header["alg"])
			}
			return []byte(os.Getenv("JWT_SECRET")), nil
		})

		if err != nil || !token.Valid {
			c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid or expired token"})
			c.Abort()
			return
		}

		// Extract claims
		if claims, ok := token.Claims.(jwt.MapClaims); ok && token.Valid {
			// Attach claims to context for use in handlers
			c.Set("claims", claims)
			c.Set("email", claims["sub"])
			c.Set("roles", claims["roles"])
		} else {
			c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid token claims"})
			c.Abort()
			return
		}

		c.Next()
	}
}
*/

