package handler

import (
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"strings"
	"taga-api/config"
	"time"

	"github.com/gin-gonic/gin"
	"go.uber.org/zap"
)

// UpdateMemberRequest holds all editable fields sent from the admin frontend
// type UpdateMemberRequest struct {
// 	Name                     string `json:"name"`
// 	Initial                  string `json:"initial"`
// 	Gender                   string `json:"gender"`
// 	FatherName               string `json:"father_name"`
// 	MotherName               string `json:"mother_name"`
// 	EducationalQualification string `json:"educational_qualification"`
// 	Designation              string `json:"designation"`
// 	WorkingDistrict          string `json:"working_district"`
// 	NativeDistrict           string `json:"native_district"`
// 	RecruitmentBatch         string `json:"recruitment_batch"`
// 	SeniorityNumber          string `json:"seniority_number"`
// 	ResidentialAddress       string `json:"residential_address"`
// 	PermanentAddress         string `json:"permanent_address"`
// 	DateOfBirth              string `json:"date_of_birth"`
// 	MobileNumber             string `json:"mobile_number"`
// 	EmailId                  string `json:"emailId"`
// 	TbfNumber                string `json:"tbf_number"`
// 	CpsGpfNumber             string `json:"cps_gpf_number"`
// }

// AdminUpdateMember godoc
// @Summary      Update a member (admin)
// @Description  Admin updates any editable field of a member and sends notification email
// @Tags         Admin Members
// @Accept       json
// @Produce      json
// @Security     BearerAuth
// @Param        id   path      string              true  "Member ID"
// @Param        body body      UpdateMemberRequest true  "Fields to update"
// @Success      200  {object}  map[string]interface{}
// @Failure      400  {object}  map[string]interface{}
// @Failure      404  {object}  map[string]interface{}
// @Failure      500  {object}  map[string]interface{}
// @Router       /api/admin/members/{id} [put]
func AdminUpdateMember(c *gin.Context) {
	memberID := c.Param("id")
	if memberID == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Member ID is required"})
		return
	}

	var req UpdateMemberRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	members, err := readExistingMembers()
	if err != nil {
		config.Logger.Error("Failed to read members", zap.Error(err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to read members"})
		return
	}

	foundIdx := -1
	for i, m := range members {
		if id, ok := m["id"].(string); ok && id == memberID {
			// Skip soft-deleted members
			if deleted, ok := m["deleted"].(bool); ok && deleted {
				c.JSON(http.StatusNotFound, gin.H{"error": "Member not found"})
				return
			}
			foundIdx = i
			break
		}
	}

	if foundIdx == -1 {
		c.JSON(http.StatusNotFound, gin.H{"error": "Member not found"})
		return
	}

	// Capture old email before update (for notification)
	oldEmail := getString(members[foundIdx], "emailId")

	// Apply all non-empty fields from the request
	applyIfNotEmpty := func(key, val string) {
		if strings.TrimSpace(val) != "" {
			members[foundIdx][key] = val
		}
	}

	applyIfNotEmpty("name", req.Name)
	applyIfNotEmpty("initial", req.Initial)
	applyIfNotEmpty("gender", req.Gender)
	applyIfNotEmpty("father_name", req.FatherName)
	applyIfNotEmpty("mother_name", req.MotherName)
	applyIfNotEmpty("educational_qualification", req.EducationalQualification)
	applyIfNotEmpty("designation", req.Designation)
	applyIfNotEmpty("working_district", req.WorkingDistrict)
	applyIfNotEmpty("native_district", req.NativeDistrict)
	applyIfNotEmpty("recruitment_batch", req.RecruitmentBatch)
	applyIfNotEmpty("seniority_number", req.SeniorityNumber)
	applyIfNotEmpty("residential_address", req.ResidentialAddress)
	applyIfNotEmpty("permanent_address", req.PermanentAddress)
	applyIfNotEmpty("date_of_birth", req.DateOfBirth)
	applyIfNotEmpty("mobile_number", req.MobileNumber)
	applyIfNotEmpty("tbf_number", req.TbfNumber)
	applyIfNotEmpty("cps_gpf_number", req.CpsGpfNumber)

	// Email update: also sync username field
	if strings.TrimSpace(req.EmailId) != "" {
		members[foundIdx]["emailId"] = req.EmailId
		members[foundIdx]["username"] = req.EmailId
	}

	members[foundIdx]["updated_at"] = time.Now().Format(time.RFC3339)

	// Persist changes
	cfg := config.GetConfig()
	data, err := json.MarshalIndent(members, "", "  ")
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to marshal members"})
		return
	}
	if err := os.WriteFile(cfg.MembersFile, data, 0644); err != nil {
		config.Logger.Error("Failed to write members file", zap.Error(err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save members"})
		return
	}

	// Send notification email — use new email if changed, otherwise old
	notifyEmail := oldEmail
	if strings.TrimSpace(req.EmailId) != "" {
		notifyEmail = req.EmailId
	}
	if notifyEmail != "" {
		memberName := getString(members[foundIdx], "name")
		if err := sendMemberUpdateEmail(notifyEmail, memberName); err != nil {
			config.Logger.Warn("Failed to send update notification email", zap.Error(err))
			// Non-fatal — do not fail the request because of email
		}
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Member updated successfully",
		"id":      memberID,
	})
}

// AdminDeleteMember godoc
// @Summary      Soft-delete a member (admin)
// @Description  Marks a member as deleted (soft delete). The record stays in the JSON file.
// @Tags         Admin Members
// @Produce      json
// @Security     BearerAuth
// @Param        id  path      string  true  "Member ID"
// @Success      200 {object}  map[string]interface{}
// @Failure      404 {object}  map[string]interface{}
// @Failure      500 {object}  map[string]interface{}
// @Router       /api/admin/members/{id} [delete]
func AdminDeleteMember(c *gin.Context) {
	memberID := c.Param("id")
	if memberID == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Member ID is required"})
		return
	}

	members, err := readExistingMembers()
	if err != nil {
		config.Logger.Error("Failed to read members", zap.Error(err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to read members"})
		return
	}

	foundIdx := -1
	for i, m := range members {
		if id, ok := m["id"].(string); ok && id == memberID {
			// Already soft-deleted
			if deleted, ok := m["deleted"].(bool); ok && deleted {
				c.JSON(http.StatusNotFound, gin.H{"error": "Member not found"})
				return
			}
			foundIdx = i
			break
		}
	}

	if foundIdx == -1 {
		c.JSON(http.StatusNotFound, gin.H{"error": "Member not found"})
		return
	}

	// Soft delete — keep record, mark as deleted
	members[foundIdx]["deleted"] = true
	members[foundIdx]["deleted_at"] = time.Now().Format(time.RFC3339)

	cfg := config.GetConfig()
	data, err := json.MarshalIndent(members, "", "  ")
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to marshal members"})
		return
	}
	if err := os.WriteFile(cfg.MembersFile, data, 0644); err != nil {
		config.Logger.Error("Failed to write members file", zap.Error(err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save members"})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "Member deleted successfully"})
}

// sendMemberUpdateEmail notifies the member that their profile was updated by admin
func sendMemberUpdateEmail(toEmail, memberName string) error {
	subject := "Your TAGA Profile Has Been Updated"

	var body strings.Builder
	body.WriteString(fmt.Sprintf("<h2>Hello %s,</h2>", memberName))
	body.WriteString("<p>Your profile information has been updated by the TAGA administrator.</p>")
	body.WriteString("<p>If you did not request this change or believe this is an error, please contact the TAGA admin team immediately.</p>")
	body.WriteString("<br><p>Best regards,<br>TAGA Team</p>")

	return sendEmail(toEmail, subject, body.String())
}
