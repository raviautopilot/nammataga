{"id":1031010,"xmlId":"org.jetbrains.plugins.node-remote-interpreter","name":"Node.js Remote Interpreter","description":"Provides <a href=\"https://nodejs.org/\">Node.js</a> support in remote environments to all JetBrains IDEs that\n   <a href=\"https://www.jetbrains.com/products/#lang=js&amp;type=ide\">support JavaScript</a>.\n\n  <h3>Features</h3>\n  <ul>\n  <li><a href=\"https://nodejs.org/\">Node.js</a> debugging for remote environments</li>\n  </ul>\n\n  <h3>Getting started</h3>\n  For information on getting started, head over to the <a href=\"https://www.jetbrains.com/help/\">documentation</a> for your IDE.\n  For WebStorm, you can check out this section in the <a href=\"https://www.jetbrains.com/help/webstorm/developing-node-js-applications.html\">documentation</a>.\n\n  <h3>Notes</h3>\n  There is a quick tour tutorial about using Node.js with Docker available on our <a href=\"https://blog.jetbrains.com/webstorm/2017/04/quick-tour-of-webstorm-and-docker/\">blog</a>.","organization":"JetBrains s.r.o.","tags":["Network"],"version":"261.23567.143","dependencies":["com.jetbrains.plugins.webDeployment","org.jetbrains.plugins.remote-run","JavaScript","JavaScriptDebugger","com.intellij.modules.ultimate","NodeJS"],"optionalDependencies":["intellij.clouds.docker.remoteRun"],"since":"261.23567","until":"261.*","size":60717,"vendor":"JetBrains","mainModuleDependencies":[{"type":"plugin","pluginId":"com.intellij.modules.ultimate"},{"type":"plugin","pluginId":"com.jetbrains.plugins.webDeployment"},{"type":"plugin","pluginId":"org.jetbrains.plugins.remote-run"},{"type":"plugin","pluginId":"JavaScript"},{"type":"plugin","pluginId":"JavaScriptDebugger"},{"type":"plugin","pluginId":"NodeJS"}],"content":[{"moduleName":"intellij.nodeJS.remoteInterpreter/docker","namespace":null}],"modules":[{"moduleName":"intellij.nodeJS.remoteInterpreter/docker","moduleDependencies":[{"type":"module","moduleName":"intellij.clouds.docker.remoteRun"}]}]}